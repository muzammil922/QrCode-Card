# Copy to .env and fill values. Never commit .env.

APP_ENV=development
API_PORT=8000

# Local Docker Compose Postgres (default)
DATABASE_URL=postgresql+psycopg://qr:qr_dev_password@localhost:5432/code
POSTGRES_USER=qr
POSTGRES_PASSWORD=qr_dev_password
POSTGRES_DB=code
POSTGRES_PORT=5432

# Flowlab / managed Postgres (example placeholders — set in host panel, not git)
# DATABASE_URL=postgresql+psycopg://QR:YOUR_PASSWORD@qrcodecard-srwlkj:5432/code


# Include Vite demo ports (5173=A, 5174=B). On Dokploy also add https://codebase.flowlab.fun
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_SECRET=change-me-in-production-m0-dev-only

# M0 demo auth stub (POST /api/v1/auth/session)
DEMO_USERNAME=demo@health.local
DEMO_PASSWORD=demo-password-change-me
